+	#define HWRM_CMPL_TYPE_HWRM_DONE			   0x20UL
+	__le16 sequence_id;
+	__le32 unused_1;
+	__le32 v;
+	#define HWRM_CMPL_V					    0x1UL
+	__le32 unused_3;
+};
+
