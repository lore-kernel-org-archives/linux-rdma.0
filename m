-static int get_dst_addr(char *dst, struct sockaddr_in *addr_in)
-{
-	struct addrinfo *res;
-	int ret;
-
-	ret = getaddrinfo(dst, NULL, NULL, &res);
-	if (ret)
-		return ret;
-
-	if (res->ai_family != PF_INET) {
-		ret = -1;
-		goto out;
-	}
-
-	*addr_in = *(struct sockaddr_in *) res->ai_addr;
-	addr_in->sin_port = htobe16(7471);
