+static void osm_dump_port_info_to_buf(IN ib_net64_t node_guid,
+				      IN ib_net64_t port_guid,
+				      IN uint8_t port_num,
+				      IN const ib_port_info_t * p_pi,
+				      OUT char * buf)
 {
